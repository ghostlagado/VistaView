# Banco de dados =================================================
# URI SQLAlchemy do warehouse. É OPCIONAL: sem esta linha o painel lê do espelho SQLite
# em instance/dw_vista_local.sqlite3, que o próprio app cria e que
# `python -m services.semente` popula. SQL Server só entra em jogo quando a URI aparece.
# DB_URI = mssql+pyodbc://usuario:senha@host:1433/dw_vista?driver=ODBC+Driver+18+for+SQL+Server
# Schema das tabelas de estrutura no SQL Server (dw_vista.dbo é o padrão quando a URI é
# mssql; no SQLite o prefixo é ignorado porque lá não existe schema cruzado).
# VISTA_ESQUEMA = dw_vista.dbo

# Ações financeiras ==============================================
# Token da brapi.dev (cadastro gratuito: 15.000 requisições/mês). Sem token a brapi
# responde 401 para quase todos os ativos — só PETR4, MGLU3, VALE3 e ITUB4 são liberados.
# Nunca versionar o token real. Comparação de provedores em docs/cotacoes.md.
ACTION_API = seu-token-da-brapi

# Aplicação ======================================================
HOST = 0.0.0.0
PORT = 8092
DEBUG = false
SECRET = troque-esta-chave   # obrigatória no modo real; em MODO_DEMO=true pode ficar em branco

# Dashboard =====================================================
# Recorte padrão exibido: GER (gerente), GR (gerente regional) ou DIR (diretor regional)
DEFAULT_OPT = GR
# Nome da regional filtrada no padrão
DEFAULT_GR = Parana Interior
# Percentual de crescimento sobre o mês anterior usado no cálculo da meta
META_PERCENTUAL = 15
# Intervalo, em segundos, do ciclo de atualização em tempo real (mínimo 15)
ATUALIZACAO_SEGUNDOS = 60

# Cotações =======================================================
# Até 5 ativos da B3, separados por vírgula. Um único processo consulta o provedor; as
# TVs leem o cache. Nomes inválidos são ignorados (e o sexto ativo é descartado).
COTACOES_SIMBOLOS = GGPS3
# Intervalo, em segundos, do ciclo que chama o provedor (mínimo 60). A resposta da brapi
# é cacheada 300 s no servidor dela, então perguntar mais rápido não muda o preço.
COTACOES_SEGUNDOS = 300
# Depois de quantos minutos a cotação aparece na tela marcada como desatualizada
COTACOES_VELHO_MIN = 15

# Demonstração ==================================================
# true troca a fonte dos indicadores por dados sintéticos (services/showcase.py):
# nada consulta o SQL Server nem a API de cotações. Com MODO_DEMO=true a `SECRET` é
# dispensada (o processo gera uma chave descartável) e o `DB_URI` também.
MODO_DEMO = false
